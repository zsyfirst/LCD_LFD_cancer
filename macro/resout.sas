*options mprint symbolgen;
%macro resout(outfile=,dbms=tab,opt=replace);
%local ext;
%if &dbms=tab %then %let _ext_=.txt;
%else %if &dbms=csv %then %let _ext_=.csv;
%else %let _ext_=;
%if %length(&resxx)>0 %then %do;
data res;
    set &resxx end=_end_;
run;
proc export data=res outfile="&outfile..res&_ext_." dbms=&dbms. &opt.;
run;
proc datasets;
    delete res &resxx;
run;
%end;
%if %length(&tresxx)>0 %then %do;
data tres;
    set &tresxx end=_end_;
run;
proc export data=tres outfile="&outfile..tres&_ext_." dbms=&dbms. &opt.;
run;
proc datasets;
    delete tres &tresxx;
run;
%end;
%symdel resno resxx tresxx;
%mend;
